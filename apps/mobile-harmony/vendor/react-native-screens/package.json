{
  "name": "react-native-screens",
  "version": "4.26.2",
  "description": "Native navigation primitives for your React Native app.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "react-native": "src/index",
  "source": "src/index",
  "types": "lib/typescript/index.d.ts",
  "files": [
    "src/",
    "common/",
    "lib/",
    "native-stack/",
    "gesture-handler/",
    "reanimated/",
    "private/",
    "experimental/",
    "android/src/main/AndroidManifest.xml",
    "android/src/main/java/",
    "android/src/main/cpp/",
    "android/src/main/jni/",
    "android/src/main/res",
    "android/src/fabric/",
    "android/src/versioned/",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "ios/",
    "cpp/",
    "windows/",
    "RNScreens.podspec",
    "react-native.config.js",
    "README.md",
    "!**/__tests__",
    "!android/src/main/java/com/swmansion/rnscreens/LifecycleHelper.kt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/software-mansion/react-native-screens.git"
  },
  "author": {
    "email": "krzys.magiera@gmail.com",
    "name": "Krzysztof Magiera"
  },
  "license": "MIT",
  "readmeFilename": "README.md",
  "bugs": {
    "url": "https://github.com/software-mansion/react-native-screens/issues"
  },
  "homepage": "https://github.com/software-mansion/react-native-screens#readme",
  "dependencies": {
    "react-freeze": "^1.0.0",
    "warn-once": "^0.1.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "lint-staged": {
    "{src,FabricExample}/**/*.{js,ts,tsx}": "yarn format-js",
    "FabricExample/ios/**/*.swift": "yarn format-ios-swift",
    "src/**/*.{js,ts,tsx}": "yarn lint-js",
    "common/**/*.{h,cpp}": "yarn format-common",
    "cpp/**/*.{h,cpp}": "yarn format-cpp",
    "android/src/main/cpp/.{cpp, h}": "yarn format-android-cpp",
    "android/**/*.kt": "yarn format-android",
    "ios/**/*.{h,m,mm,cpp}": "yarn format-ios-cpp"
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "codegenConfig": {
    "name": "rnscreens",
    "type": "all",
    "jsSrcsDir": "./src/fabric",
    "android": {
      "javaPackageName": "com.swmansion.rnscreens"
    },
    "ios": {
      "components": {
        "RNSFullWindowOverlay": {
          "className": "RNSFullWindowOverlay"
        },
        "RNSModalScreen": {
          "className": "RNSModalScreen"
        },
        "RNSScreenContainer": {
          "className": "RNSScreenContainerView"
        },
        "RNSScreenContentWrapper": {
          "className": "RNSScreenContentWrapper"
        },
        "RNSScreenFooter": {
          "className": "RNSScreenFooter"
        },
        "RNSScreen": {
          "className": "RNSScreenView"
        },
        "RNSScreenNavigationContainer": {
          "className": "RNSScreenNavigationContainerView"
        },
        "RNSScreenStackHeaderConfig": {
          "className": "RNSScreenStackHeaderConfig"
        },
        "RNSScreenStackHeaderSubview": {
          "className": "RNSScreenStackHeaderSubview"
        },
        "RNSScreenStack": {
          "className": "RNSScreenStackView"
        },
        "RNSSearchBar": {
          "className": "RNSSearchBar"
        },
        "RNSStackScreen": {
          "className": "RNSStackScreenComponentView"
        },
        "RNSStackHost": {
          "className": "RNSStackHostComponentView"
        },
        "RNSStackHeaderConfigIOS": {
          "className": "RNSStackHeaderConfigComponentView"
        },
        "RNSStackHeaderItemIOS": {
          "className": "RNSStackHeaderItemComponentView"
        },
        "RNSStackHeaderItemSpacerIOS": {
          "className": "RNSStackHeaderItemSpacerComponentView"
        },
        "RNSTabsScreenIOS": {
          "className": "RNSTabsScreenComponentView"
        },
        "RNSTabsHostIOS": {
          "className": "RNSTabsHostComponentView"
        },
        "RNSTabsBottomAccessory": {
          "className": "RNSTabsBottomAccessoryComponentView"
        },
        "RNSTabsBottomAccessoryContent": {
          "className": "RNSTabsBottomAccessoryContentComponentView"
        },
        "RNSSplitHost": {
          "className": "RNSSplitHostComponentView"
        },
        "RNSSplitScreen": {
          "className": "RNSSplitScreenComponentView"
        },
        "RNSSafeAreaView": {
          "className": "RNSSafeAreaViewComponentView"
        },
        "RNSScrollViewMarker": {
          "className": "RNSScrollViewMarkerComponentView"
        },
        "RNSFormSheetHost": {
          "className": "RNSFormSheetHostComponentView"
        },
        "RNSFormSheetContentWrapper": {
          "className": "RNSFormSheetContentWrapperComponentView"
        }
      }
    }
  },
  "packageManager": "yarn@4.1.1",
  "harmony": {
    "alias": "react-native-screens",
    "redirectInternalImports": true
  }
}