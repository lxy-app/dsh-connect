{
  "expo": {
    "name": "DSH Connect",
    "slug": "dsh-connect",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dshconnect",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.deepseek.dshconnect",
      "buildNumber": "1",
      "icon": "./assets/expo.icon",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.deepseek.dshconnect",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#585CE8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-dev-client",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "允许 $(PRODUCT_NAME) 使用 Face ID 保护设备凭据。"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "允许 $(PRODUCT_NAME) 使用 Face ID 验证敏感操作。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许 $(PRODUCT_NAME) 使用相机扫描配对二维码。",
          "microphonePermission": "允许 $(PRODUCT_NAME) 使用麦克风将你的语音转写为指令。",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#585CE8",
          "defaultChannel": "default",
          "enableRemoteNotifications": true,
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "允许 $(PRODUCT_NAME) 使用麦克风将你的语音转写为指令。",
          "speechRecognitionPermission": "允许 $(PRODUCT_NAME) 使用系统语音识别将你的语音转写为指令。"
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
