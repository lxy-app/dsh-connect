{
  "name": "@dsh-connect/mobile",
  "version": "0.1.0",
  "description": "DSH Connect mobile app for iOS and Android, built with Expo and React Native.",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "build:bundles": "expo export --platform ios --platform android"
  },
  "dependencies": {
    "@expo/ui": "~58.0.26",
    "expo": "~58.0.22",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "^58.0.1",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
