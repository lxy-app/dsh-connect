# DSH Connect 配置模板：复制为 .env 并填入真实值。
#   cp .env.example .env && sed -i '' "s|^DSH_CONNECT_BOOTSTRAP_TOKEN=.*|DSH_CONNECT_BOOTSTRAP_TOKEN=$(openssl rand -hex 32)|" .env

# ---------- Go Server（server/cmd/server）----------

# 管理/调试 REST + WSS 的 Bearer 令牌，必填，无默认值，无未鉴权启动。
# 生成方式：openssl rand -hex 32
DSH_CONNECT_BOOTSTRAP_TOKEN=replace-with-a-long-random-token

# HTTP 监听地址，默认回环。
DSH_CONNECT_LISTEN_ADDR=127.0.0.1:8787

# 数据库连接串：默认 PostgreSQL 18；`make db-up` 会启动本地实例。
# Server 启动时通过 ent 集成的 Atlas 自动执行 schema 迁移（不主动删列/索引）。
# 单实例可选择 SQLite，无需 `make db-up`，例如：
# DSH_CONNECT_DATABASE_URL=sqlite:///absolute/path/to/dsh-connect.db
# Docker 一体镜像使用 sqlite:///data/sqlite/dsh-connect.db，并挂载 /data/sqlite。
DSH_CONNECT_DATABASE_URL=postgres://dsh:dsh@127.0.0.1:5432/dsh_connect?sslmode=disable

# 首次启动时的 Owner 引导账号：仅当 users 表为空时创建，之后不再覆盖。
# 留空则不创建任何账号，管理后台将无法登录。
DSH_CONNECT_BOOTSTRAP_OWNER_EMAIL=owner@example.com
DSH_CONNECT_BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-password
DSH_CONNECT_BOOTSTRAP_OWNER_NAME=Owner

# 可选：托管 apps/admin 的构建产物目录；设置后 Admin 与 /v1 API 同源。
# Docker 镜像内置为 /app/admin，本地默认不启用。
# DSH_CONNECT_ADMIN_DIR=

# 管理后台来源。逗号分隔多个 origin；留空时仅放行 loopback（开发默认）。
# 同源部署不需要设置；Admin 独立域名部署时务必显式设置，例如 https://admin.example.com
# DSH_CONNECT_ADMIN_ORIGIN=https://admin.example.com

# 配对码响应中返回的外部 Server URL；留空则按监听地址自动推导。
DSH_CONNECT_SERVER_URL=http://127.0.0.1:8787

# 手机配对与令牌有效期（Go duration）。Access 短期、Refresh 轮换，均只存 hash。
# DSH_CONNECT_MOBILE_PAIRING_TTL=5m
# DSH_CONNECT_MOBILE_ACCESS_TTL=15m
# DSH_CONNECT_MOBILE_REFRESH_TTL=720h

# 可选 TLS；两者必须同时设置，设置后对外变为 https/wss。
# DSH_CONNECT_TLS_CERT_FILE=
# DSH_CONNECT_TLS_KEY_FILE=

# 移动端附件（会话交付/返回的图片与文件）。
# off 关闭；read 允许手机下载；readwrite 预留给手机上行的后续阶段。
# DSH_CONNECT_ATTACHMENTS=read
# 单文件上限与 blob 目录总量上限（字节）。超限返回 413。
# DSH_CONNECT_MAX_ATTACHMENT_BYTES=20971520
# DSH_CONNECT_MAX_ATTACHMENT_STORE_BYTES=2147483648
# blob 未访问回收周期；元数据行比 blob 保留更久，便于手机看到明确状态。
# DSH_CONNECT_ATTACHMENT_TTL=168h
# blob 目录；容器部署必须挂卷，否则重建后字节丢失（元数据仍在，可重新拉取）。
# DSH_CONNECT_ATTACHMENT_DIR=./dsh-connect-attachments

# ---------- 调试客户端 / Connector ----------

# 调试 CLI 连接的 Server 地址（兼容别名 DSH_CONNECT_SERVER_URL）。
DSH_CONNECT_URL=http://127.0.0.1:8787

# 调试 CLI 的 Bearer 令牌，必须与 DSH_CONNECT_BOOTSTRAP_TOKEN 一致。
DSH_CONNECT_TOKEN=replace-with-a-long-random-token

# Connector 本地状态文件（含设备凭据），默认 ~/.dsh-connect/connector.json。
# DSH_CONNECT_STATE_FILE=

# ---------- 测试 ----------

# make test-server / test-e2e 会分别运行 postgres 与 sqlite；直接运行单项测试时
# 可用 DSH_CONNECT_TEST_DATABASE_DIALECT=postgres|sqlite 选择，默认 postgres。
# 复用已有 PostgreSQL 跑 Server 测试（pgtest 会为每个测试建独立库）。
# 留空则自动用 Docker 拉起临时容器。
# DSH_CONNECT_TEST_DATABASE_URL=postgres://dsh:dsh@127.0.0.1:5432/postgres?sslmode=disable

# 可选：PostgreSQL E2E 使用独立业务数据库；不要使用共享开发库或上述维护库。
# SQLite E2E 总是使用自己的临时文件，无需配置。
# DSH_CONNECT_E2E_DATABASE_URL=postgres://dsh:dsh@127.0.0.1:5432/dsh_connect_e2e?sslmode=disable

# 设置为 1 时，缺少 Docker 会让 PostgreSQL 测试失败而不是跳过。
# DSH_CONNECT_REQUIRE_PG=1

# ---------- Website 静态部署（make website-deploy）----------
# 以下均为私密部署信息；真实值只写入不提交的本机 .env。
# WEBSITE_REMOTE=deploy-user@example.com
# WEBSITE_REMOTE_DIR=/srv/www/example.com/dsh-connect
# WEBSITE_BACKUP_DIR=/srv/backups/example.com/dsh-connect
# 可选：指定私钥；留空则使用 SSH Agent 或本机默认密钥。
# WEBSITE_SSH_KEY=/home/you/.ssh/id_ed25519
