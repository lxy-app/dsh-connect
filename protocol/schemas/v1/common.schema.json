{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-connect.local/schemas/v1/common.schema.json",
  "title": "DSH Connect common v1 DTOs",
  "$defs": {
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "properties": {
            "submitted": {
              "type": "boolean",
              "description": "false only when Server proved a create, prompt or model-selection command was not submitted to Connector; absence or true does not prove submission."
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "required": [
        "v",
        "error"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "additionalProperties": false
    },
    "Workspace": {
      "type": "object",
      "required": [
        "id",
        "name",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    },
    "Scope": {
      "type": "string",
      "enum": [
        "read",
        "prompt",
        "approve",
        "cancel"
      ]
    },
    "Device": {
      "type": "object",
      "required": [
        "deviceId",
        "deviceName",
        "fingerprint",
        "connectorVersion",
        "status",
        "workspaces",
        "scopes",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "deviceName": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "connectorVersion": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "waiting_desktop_authorization",
            "online",
            "offline"
          ]
        },
        "workspaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Workspace"
          }
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scope"
          },
          "uniqueItems": true
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "ContentPart": {
      "description": "One prompt content part. Text parts carry inline text; image and file parts reference an attachment this Session uploaded. The Server may add the verified display name and MIME type for Connector staging; callers never supply paths or bytes.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "attachmentId"
          ],
          "properties": {
            "type": {
              "const": "image"
            },
            "attachmentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "mime": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "attachmentId"
          ],
          "properties": {
            "type": {
              "const": "file"
            },
            "attachmentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "mime": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ModelSelection": {
      "type": "object",
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reasoningEffort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "Session": {
      "type": "object",
      "required": [
        "id",
        "title",
        "workspaceId",
        "status",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "SessionCreateResult": {
      "type": "object",
      "required": [
        "sessionId",
        "workspaceId"
      ],
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        },
        "agentPreset": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SessionListResult": {
      "type": "object",
      "required": [
        "sessions"
      ],
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Session"
          }
        }
      },
      "additionalProperties": true
    },
    "SessionPageResult": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "nextCursor": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "SessionPromptResult": {
      "type": "object",
      "required": [
        "sessionId",
        "requestId",
        "status"
      ],
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "status": {
          "const": "accepted"
        }
      },
      "additionalProperties": true
    },
    "SessionCancelResult": {
      "type": "object",
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
