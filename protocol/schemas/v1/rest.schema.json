{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-connect.local/schemas/v1/rest.schema.json",
  "title": "DSH Connect debug REST DTOs v1",
  "$defs": {
    "DesktopCodeResponse": {
      "type": "object",
      "required": ["code", "expiresAt", "serverUrl"],
      "properties": {
        "code": {"type": "string"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "serverUrl": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "DeviceListResponse": {
      "type": "object",
      "required": ["devices"],
      "properties": {"devices": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/Device"}}},
      "additionalProperties": false
    },
    "SessionCreateRequest": {
      "type": "object",
      "required": ["requestId", "deviceId", "workspaceId"],
      "properties": {
        "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
        "deviceId": {"type": "string", "minLength": 1},
        "workspaceId": {"type": "string", "minLength": 1},
        "timeoutMs": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "SessionPromptRequest": {
      "type": "object",
      "required": ["requestId", "deviceId", "mode", "content"],
      "properties": {
        "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
        "deviceId": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "enum": ["queue", "steer"]},
        "content": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/ContentPart"}},
        "clientTimeZone": {"type": "string"},
        "timeoutMs": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "SessionCancelRequest": {
      "type": "object",
      "required": ["requestId", "deviceId"],
      "properties": {
        "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
        "deviceId": {"type": "string", "minLength": 1},
        "timeoutMs": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
