{
  "name": "@lxyapp/dsh-connect",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "DeepSeek Harness desktop connector for DSH Connect.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "clean:test": "node -e \"require('node:fs').rmSync('.test-build', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/strip-client-export.mjs",
    "build:test": "npm run clean:test && tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && npm run build && npm run build:test && node --test .test-build/test/*.test.js",
    "test:e2e": "npm run typecheck && npm run build && npm run build:test && node .test-build/test/server-e2e.js",
    "debug": "npm run build:test && node .test-build/src/bin/debug-client.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24",
    "dsh": "0.2.1-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.5"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
